{
  "manifest_version": 1,
  "type": "communication",
  "name": "Bark",
  "description": {
    "en": "Gladys messages and scene notifications on your iPhone with the Bark app.",
    "fr": "Les messages de Gladys et des notifications de scène sur votre iPhone avec l'appli Bark.",
    "de": "Gladys-Nachrichten und Szenen-Benachrichtigungen auf deinem iPhone mit der Bark-App.",
    "es": "Mensajes de Gladys y notificaciones de escenas en su iPhone con la aplicación Bark."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-bark:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-bark/main/cover.png",
  "categories": ["notifications"],
  "transports": ["cloud"],
  "messaging": {
    "receive": false
  },
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your iPhone",
        "fr": "Connecter votre iPhone",
        "de": "Dein iPhone verbinden",
        "es": "Conectar su iPhone"
      },
      "description": {
        "en": "Install the free Bark app on the iPhone and copy the address it shows (https://api.day.app/…): its key goes below. Each Gladys user can also enter the key of their own iPhone in the \"My account\" block.",
        "fr": "Installez l'appli gratuite Bark sur l'iPhone et copiez l'adresse qu'elle affiche (https://api.day.app/…) : sa clé va ci-dessous. Chaque utilisateur de Gladys peut aussi saisir la clé de son iPhone dans le bloc « Mon compte ».",
        "de": "Installiere die kostenlose Bark-App auf dem iPhone und kopiere die angezeigte Adresse (https://api.day.app/…): Der Schlüssel kommt unten hinein. Jeder Gladys-Benutzer kann im Block „Mein Konto“ auch den Schlüssel seines iPhones angeben.",
        "es": "Instale la aplicación gratuita Bark en el iPhone y copie la dirección que muestra (https://api.day.app/…): su clave va a continuación. Cada usuario de Gladys también puede indicar la clave de su iPhone en el bloque «Mi cuenta»."
      },
      "links": [
        {
          "url": "https://apps.apple.com/app/bark-customed-notifications/id1403753865",
          "label": {
            "en": "Bark on the App Store",
            "fr": "Bark sur l'App Store",
            "de": "Bark im App Store",
            "es": "Bark en la App Store"
          }
        },
        {
          "url": "https://bark.day.app/",
          "label": {
            "en": "Bark documentation",
            "fr": "Documentation de Bark",
            "de": "Bark-Dokumentation",
            "es": "Documentación de Bark"
          }
        }
      ]
    },
    {
      "key": "server_url",
      "type": "string",
      "label": {
        "en": "Bark server address",
        "fr": "Adresse du serveur Bark",
        "de": "Adresse des Bark-Servers",
        "es": "Dirección del servidor Bark"
      },
      "description": {
        "en": "The official server, or your own bark-server: the one chosen in the Bark app.",
        "fr": "Le serveur officiel, ou votre propre bark-server : celui choisi dans l'appli Bark.",
        "de": "Der offizielle Server oder dein eigener bark-server: der in der Bark-App gewählte.",
        "es": "El servidor oficial o su propio bark-server: el elegido en la aplicación Bark."
      },
      "placeholder": {
        "en": "https://api.day.app",
        "fr": "https://api.day.app",
        "de": "https://api.day.app",
        "es": "https://api.day.app"
      },
      "required": false,
      "default": "https://api.day.app"
    },
    {
      "key": "device_keys",
      "type": "secret",
      "label": {
        "en": "Device keys for scenes",
        "fr": "Clés d'appareil pour les scènes",
        "de": "Geräteschlüssel für Szenen",
        "es": "Claves de dispositivo para escenas"
      },
      "description": {
        "en": "Used by the scene action and the test. Several iPhones: separate the keys with commas. The whole address copied from the app works too.",
        "fr": "Utilisées par l'action de scène et le test. Plusieurs iPhone : séparez les clés par des virgules. L'adresse entière copiée de l'appli convient aussi.",
        "de": "Für die Szenenaktion und den Test. Mehrere iPhones: Trenne die Schlüssel durch Kommas. Die ganze aus der App kopierte Adresse geht auch.",
        "es": "Los usan la acción de escena y la prueba. Varios iPhone: separe las claves con comas. También sirve la dirección completa copiada de la aplicación."
      },
      "placeholder": {
        "en": "Key from the Bark app",
        "fr": "Clé de l'appli Bark",
        "de": "Schlüssel aus der Bark-App",
        "es": "Clave de la aplicación Bark"
      },
      "required": false
    },
    {
      "key": "default_level",
      "type": "select",
      "label": {
        "en": "Default level",
        "fr": "Niveau par défaut",
        "de": "Standardstufe",
        "es": "Nivel predeterminado"
      },
      "description": {
        "en": "How iOS presents the notifications. Critical needs the permission granted in the Bark app.",
        "fr": "Comment iOS présente les notifications. Critique demande l'autorisation accordée dans l'appli Bark.",
        "de": "Wie iOS die Benachrichtigungen zeigt. Kritisch braucht die Erlaubnis in der Bark-App.",
        "es": "Cómo presenta iOS las notificaciones. Crítica requiere el permiso concedido en la aplicación Bark."
      },
      "required": false,
      "default": "active",
      "options": [
        {
          "value": "active",
          "label": {
            "en": "Normal: sound and banner",
            "fr": "Normale : son et bandeau",
            "de": "Normal: Ton und Banner",
            "es": "Normal: sonido y aviso"
          }
        },
        {
          "value": "timeSensitive",
          "label": {
            "en": "Time-sensitive: shown even in Focus",
            "fr": "Urgente : affichée même en mode Concentration",
            "de": "Zeitkritisch: auch im Fokus-Modus",
            "es": "Urgente: se muestra incluso en modo Concentración"
          }
        },
        {
          "value": "passive",
          "label": {
            "en": "Passive: silent, in the list only",
            "fr": "Discrète : silencieuse, dans la liste seulement",
            "de": "Passiv: lautlos, nur in der Liste",
            "es": "Pasiva: silenciosa, solo en la lista"
          }
        },
        {
          "value": "critical",
          "label": {
            "en": "Critical: sounds even when muted",
            "fr": "Critique : sonne même en silencieux",
            "de": "Kritisch: klingelt auch im Stumm-Modus",
            "es": "Crítica: suena incluso en silencio"
          }
        }
      ]
    },
    {
      "key": "group",
      "type": "string",
      "label": {
        "en": "Notification group",
        "fr": "Groupe des notifications",
        "de": "Benachrichtigungsgruppe",
        "es": "Grupo de notificaciones"
      },
      "description": {
        "en": "Bark groups notifications by this name in the app and on the lock screen.",
        "fr": "Bark regroupe les notifications sous ce nom dans l'appli et sur l'écran verrouillé.",
        "de": "Bark gruppiert die Benachrichtigungen unter diesem Namen in der App und auf dem Sperrbildschirm.",
        "es": "Bark agrupa las notificaciones con este nombre en la aplicación y en la pantalla bloqueada."
      },
      "required": false,
      "default": "Gladys"
    },
    {
      "key": "encryption_key",
      "type": "secret",
      "label": {
        "en": "Encryption key (optional)",
        "fr": "Clé de chiffrement (facultative)",
        "de": "Verschlüsselungsschlüssel (optional)",
        "es": "Clave de cifrado (opcional)"
      },
      "description": {
        "en": "Same key as in the Bark app (Encryption settings: AES, CBC mode, 16, 24 or 32 characters). Empty: not encrypted.",
        "fr": "Même clé que dans l'appli Bark (réglages de chiffrement : AES, mode CBC, 16, 24 ou 32 caractères). Vide : pas de chiffrement.",
        "de": "Derselbe Schlüssel wie in der Bark-App (Verschlüsselung: AES, Modus CBC, 16, 24 oder 32 Zeichen). Leer: unverschlüsselt.",
        "es": "La misma clave que en la aplicación Bark (cifrado: AES, modo CBC, 16, 24 o 32 caracteres). Vacío: sin cifrado."
      },
      "required": false
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept a self-signed certificate",
        "fr": "Accepter un certificat auto-signé",
        "de": "Selbstsigniertes Zertifikat akzeptieren",
        "es": "Aceptar un certificado autofirmado"
      },
      "description": {
        "en": "Only for an https:// address whose certificate you created yourself.",
        "fr": "Seulement pour une adresse en https:// dont vous avez créé le certificat vous-même.",
        "de": "Nur für eine https://-Adresse, deren Zertifikat du selbst erstellt hast.",
        "es": "Solo para una dirección https:// cuyo certificado haya creado usted mismo."
      },
      "required": false,
      "default": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the integration texts",
        "fr": "Langue des textes de l'intégration",
        "de": "Sprache der Texte der Integration",
        "es": "Idioma de los textos de la integración"
      },
      "description": {
        "en": "Used for the errors of the scene action, the test notification and the note added to messages.",
        "fr": "Pour les erreurs de l'action de scène, la notification de test et la mention ajoutée aux messages.",
        "de": "Für die Fehler der Szenenaktion, die Testbenachrichtigung und den Hinweis in den Nachrichten.",
        "es": "Para los errores de la acción de escena, la notificación de prueba y la nota añadida a los mensajes."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "contact_schema": [
    {
      "key": "account",
      "type": "section",
      "label": {
        "en": "Your Bark notifications",
        "fr": "Vos notifications Bark",
        "de": "Deine Bark-Benachrichtigungen",
        "es": "Sus notificaciones Bark"
      },
      "description": {
        "en": "To receive on your iPhone the messages Gladys sends you, paste the key (or the address) shown by YOUR Bark app. Leave it empty to receive nothing.",
        "fr": "Pour recevoir sur votre iPhone les messages que Gladys vous envoie, collez la clé (ou l'adresse) affichée par VOTRE appli Bark. Laissez vide pour ne rien recevoir.",
        "de": "Um die Nachrichten von Gladys auf deinem iPhone zu erhalten, füge den Schlüssel (oder die Adresse) DEINER Bark-App ein. Leer lassen, um nichts zu erhalten.",
        "es": "Para recibir en su iPhone los mensajes que Gladys le envía, pegue la clave (o la dirección) que muestra SU aplicación Bark. Déjelo vacío para no recibir nada."
      }
    },
    {
      "key": "device_key",
      "type": "secret",
      "label": {
        "en": "Your device key",
        "fr": "Votre clé d'appareil",
        "de": "Dein Geräteschlüssel",
        "es": "Su clave de dispositivo"
      },
      "placeholder": {
        "en": "Key from your Bark app",
        "fr": "Clé de votre appli Bark",
        "de": "Schlüssel aus deiner Bark-App",
        "es": "Clave de su aplicación Bark"
      },
      "required": false
    },
    {
      "key": "level",
      "type": "select",
      "label": {
        "en": "Level of your messages",
        "fr": "Niveau de vos messages",
        "de": "Stufe deiner Nachrichten",
        "es": "Nivel de sus mensajes"
      },
      "required": false,
      "options": [
        {
          "value": "default",
          "label": {
            "en": "Default of the integration",
            "fr": "Par défaut de l'intégration",
            "de": "Standard der Integration",
            "es": "Predeterminado de la integración"
          }
        },
        {
          "value": "active",
          "label": {
            "en": "Normal: sound and banner",
            "fr": "Normale : son et bandeau",
            "de": "Normal: Ton und Banner",
            "es": "Normal: sonido y aviso"
          }
        },
        {
          "value": "timeSensitive",
          "label": {
            "en": "Time-sensitive: shown even in Focus",
            "fr": "Urgente : affichée même en mode Concentration",
            "de": "Zeitkritisch: auch im Fokus-Modus",
            "es": "Urgente: se muestra incluso en modo Concentración"
          }
        },
        {
          "value": "passive",
          "label": {
            "en": "Passive: silent, in the list only",
            "fr": "Discrète : silencieuse, dans la liste seulement",
            "de": "Passiv: lautlos, nur in der Liste",
            "es": "Pasiva: silenciosa, solo en la lista"
          }
        },
        {
          "value": "critical",
          "label": {
            "en": "Critical: sounds even when muted",
            "fr": "Critique : sonne même en silencieux",
            "de": "Kritisch: klingelt auch im Stumm-Modus",
            "es": "Crítica: suena incluso en silencio"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Send a test notification",
        "fr": "Envoyer une notification de test",
        "de": "Testbenachrichtigung senden",
        "es": "Enviar una notificación de prueba"
      },
      "description": {
        "en": "Checks the server, then sends a notification to the device keys for scenes.",
        "fr": "Vérifie le serveur, puis envoie une notification aux clés d'appareil pour les scènes.",
        "de": "Prüft den Server und sendet dann eine Benachrichtigung an die Geräteschlüssel für Szenen.",
        "es": "Comprueba el servidor y envía una notificación a las claves de dispositivo para escenas."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "server_offline",
      "label": {
        "en": "Bark server offline",
        "fr": "Serveur Bark hors ligne",
        "de": "Bark-Server offline",
        "es": "Servidor Bark sin conexión"
      },
      "description": {
        "en": "The Bark server stopped answering (two checks 30 seconds apart).",
        "fr": "Le serveur Bark ne répond plus (deux vérifications à 30 secondes d'écart).",
        "de": "Der Bark-Server antwortet nicht mehr (zwei Prüfungen im Abstand von 30 Sekunden).",
        "es": "El servidor Bark ha dejado de responder (dos comprobaciones con 30 segundos de diferencia)."
      },
      "variables": [
        {
          "key": "error",
          "type": "string",
          "label": {
            "en": "Error",
            "fr": "Erreur",
            "de": "Fehler",
            "es": "Error"
          }
        }
      ]
    },
    {
      "key": "server_online",
      "label": {
        "en": "Bark server back online",
        "fr": "Serveur Bark de retour",
        "de": "Bark-Server wieder online",
        "es": "Servidor Bark de nuevo en línea"
      },
      "description": {
        "en": "The Bark server answers again after being offline.",
        "fr": "Le serveur Bark répond de nouveau après avoir été hors ligne.",
        "de": "Der Bark-Server antwortet wieder, nachdem er offline war.",
        "es": "El servidor Bark vuelve a responder tras estar sin conexión."
      },
      "variables": [
        {
          "key": "version",
          "type": "string",
          "label": {
            "en": "Server version (empty when unknown)",
            "fr": "Version du serveur (vide si inconnue)",
            "de": "Serverversion (leer, wenn unbekannt)",
            "es": "Versión del servidor (vacía si se desconoce)"
          }
        }
      ]
    },
    {
      "key": "delivery_failed",
      "label": {
        "en": "Bark notification not sent",
        "fr": "Notification Bark non envoyée",
        "de": "Bark-Benachrichtigung nicht gesendet",
        "es": "Notificación Bark no enviada"
      },
      "description": {
        "en": "A message could not be sent. At most once per reason every 15 minutes.",
        "fr": "Un message n'a pas pu être envoyé. Au plus une fois par raison toutes les 15 minutes.",
        "de": "Eine Nachricht konnte nicht gesendet werden. Höchstens einmal pro Grund alle 15 Minuten.",
        "es": "No se ha podido enviar un mensaje. Como máximo una vez por motivo cada 15 minutos."
      },
      "fields": [
        {
          "key": "reason",
          "type": "multi_select",
          "label": {
            "en": "Reason",
            "fr": "Raison",
            "de": "Grund",
            "es": "Motivo"
          },
          "options": [
            {
              "value": "unreachable",
              "label": {
                "en": "Server unreachable",
                "fr": "Serveur injoignable",
                "de": "Server nicht erreichbar",
                "es": "Servidor inaccesible"
              }
            },
            {
              "value": "key",
              "label": {
                "en": "Device key missing or refused",
                "fr": "Clé d'appareil absente ou refusée",
                "de": "Geräteschlüssel fehlt oder abgelehnt",
                "es": "Clave de dispositivo ausente o rechazada"
              }
            },
            {
              "value": "configuration",
              "label": {
                "en": "Configuration incomplete",
                "fr": "Configuration incomplète",
                "de": "Konfiguration unvollständig",
                "es": "Configuración incompleta"
              }
            },
            {
              "value": "rejected",
              "label": {
                "en": "Message refused",
                "fr": "Message refusé",
                "de": "Nachricht abgelehnt",
                "es": "Mensaje rechazado"
              }
            }
          ]
        },
        {
          "key": "origin",
          "type": "multi_select",
          "label": {
            "en": "Sent by",
            "fr": "Envoyé par",
            "de": "Gesendet von",
            "es": "Enviado por"
          },
          "options": [
            {
              "value": "gladys_message",
              "label": {
                "en": "A Gladys message",
                "fr": "Un message de Gladys",
                "de": "Eine Gladys-Nachricht",
                "es": "Un mensaje de Gladys"
              }
            },
            {
              "value": "scene_action",
              "label": {
                "en": "The Bark scene action",
                "fr": "L'action de scène Bark",
                "de": "Die Bark-Szenenaktion",
                "es": "La acción de escena Bark"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "reason",
          "type": "string",
          "label": {
            "en": "Reason",
            "fr": "Raison",
            "de": "Grund",
            "es": "Motivo"
          }
        },
        {
          "key": "origin",
          "type": "string",
          "label": {
            "en": "Sent by",
            "fr": "Envoyé par",
            "de": "Gesendet von",
            "es": "Enviado por"
          }
        },
        {
          "key": "error",
          "type": "string",
          "label": {
            "en": "Error",
            "fr": "Erreur",
            "de": "Fehler",
            "es": "Error"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "send_notification",
      "label": {
        "en": "Send a Bark notification",
        "fr": "Envoyer une notification Bark",
        "de": "Bark-Benachrichtigung senden",
        "es": "Enviar una notificación Bark"
      },
      "description": {
        "en": "With title, level, sound, link and image, to the device keys for scenes.",
        "fr": "Avec titre, niveau, son, lien et image, aux clés d'appareil pour les scènes.",
        "de": "Mit Titel, Stufe, Ton, Link und Bild, an die Geräteschlüssel für Szenen.",
        "es": "Con título, nivel, sonido, enlace e imagen, a las claves de dispositivo para escenas."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "subtitle",
          "type": "string",
          "label": {
            "en": "Subtitle",
            "fr": "Sous-titre",
            "de": "Untertitel",
            "es": "Subtítulo"
          }
        },
        {
          "key": "message",
          "type": "string",
          "label": {
            "en": "Message",
            "fr": "Message",
            "de": "Nachricht",
            "es": "Mensaje"
          },
          "required": true
        },
        {
          "key": "level",
          "type": "select",
          "label": {
            "en": "Level",
            "fr": "Niveau",
            "de": "Stufe",
            "es": "Nivel"
          },
          "required": false,
          "options": [
            {
              "value": "default",
              "label": {
                "en": "Default of the integration",
                "fr": "Par défaut de l'intégration",
                "de": "Standard der Integration",
                "es": "Predeterminado de la integración"
              }
            },
            {
              "value": "active",
              "label": {
                "en": "Normal: sound and banner",
                "fr": "Normale : son et bandeau",
                "de": "Normal: Ton und Banner",
                "es": "Normal: sonido y aviso"
              }
            },
            {
              "value": "timeSensitive",
              "label": {
                "en": "Time-sensitive: shown even in Focus",
                "fr": "Urgente : affichée même en mode Concentration",
                "de": "Zeitkritisch: auch im Fokus-Modus",
                "es": "Urgente: se muestra incluso en modo Concentración"
              }
            },
            {
              "value": "passive",
              "label": {
                "en": "Passive: silent, in the list only",
                "fr": "Discrète : silencieuse, dans la liste seulement",
                "de": "Passiv: lautlos, nur in der Liste",
                "es": "Pasiva: silenciosa, solo en la lista"
              }
            },
            {
              "value": "critical",
              "label": {
                "en": "Critical: sounds even when muted",
                "fr": "Critique : sonne même en silencieux",
                "de": "Kritisch: klingelt auch im Stumm-Modus",
                "es": "Crítica: suena incluso en silencio"
              }
            }
          ]
        },
        {
          "key": "sound",
          "type": "select",
          "label": {
            "en": "Sound",
            "fr": "Son",
            "de": "Ton",
            "es": "Sonido"
          },
          "required": false,
          "options": [
            {
              "value": "default",
              "label": {
                "en": "Default of the Bark app",
                "fr": "Par défaut de l'appli Bark",
                "de": "Standard der Bark-App",
                "es": "Predeterminado de la aplicación Bark"
              }
            },
            {
              "value": "alarm",
              "label": {
                "en": "alarm",
                "fr": "alarm",
